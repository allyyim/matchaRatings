# PostgreSQL connection string, example:
# postgres://postgres:postgres@localhost:5432/matcha_ratings
DATABASE_URL=postgresql://postgres.bpwlpozfefioqkxsqnhj:iTDi40rJxozOt3iZ@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify
# Optional: set to disable ssl for local postgres
PGSSLMODE=require
NODE_ENV=production
NODE_OPTIONS=--dns-result-order=ipv4first
# Public URL of the deployed frontend, used in magic-link emails
APP_ORIGIN=https://allyyim.github.io/matchaRatings
# Resend API key for sending magic-link emails (https://resend.com/api-keys)
# If unset, magic links are logged to the server console instead of emailed (dev fallback).
RESEND_API_KEY=
# Verified "from" address for Resend, e.g. Sip & Score <login@yourdomain.com>
EMAIL_FROM=Sip & Score <onboarding@resend.dev>
